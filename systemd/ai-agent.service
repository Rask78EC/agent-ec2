[Unit]
Description=Agente de IA en sandbox
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
User=ai_agent_executor
WorkingDirectory=/opt/agent_workspace
Environment=AWS_REGION=us-east-1
ExecStart=/usr/bin/python3 -u /opt/agent/agent.py
StandardOutput=append:/var/log/ai-agent/agent.log
StandardError=append:/var/log/ai-agent/agent.log
LogsDirectory=ai-agent
Restart=on-failure
RestartSec=5

# Límites de recursos
MemoryMax=512M
CPUQuota=50%

# Endurecimiento
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/agent_workspace

[Install]
WantedBy=multi-user.target